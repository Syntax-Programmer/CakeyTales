---
---

<section id="enquiries" class="py-16 sm:py-24 bg-[#FAF6F0] relative overflow-hidden">
  
  <!-- Ambient background accents -->
  <div class="absolute -top-32 -left-32 w-80 h-80 rounded-full bg-[#FCECEF] blur-3xl opacity-60 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-32 -right-32 w-80 h-80 rounded-full bg-[#FDF1CE] blur-3xl opacity-50 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="rounded-[2.5rem] sm:rounded-[3rem] bg-[#FFFDF9] border border-[#F0E4D8] p-6 sm:p-12 lg:p-16 shadow-[0_20px_50px_rgba(44,24,16,0.06)]">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left Column: Commission Invitation & Direct Connect Links -->
        <div class="lg:col-span-5 space-y-8">
          
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FCECEF] text-xs font-semibold tracking-wider text-[#E34A6F] uppercase mb-4">
              <span>✦</span>
              Bespoke Commission Inquiries
            </div>
            <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#2C1810] tracking-tight leading-tight">
              Have a <span class="text-[#E34A6F] italic font-normal">Sweet Idea</span> in Mind?
            </h2>
            <p class="text-base text-[#6B554B] font-light mt-4 leading-relaxed">
              Whether you are planning a magnificent wedding, an intimate anniversary banquet, or a modern sculpted celebration, every CakeyTales creation begins with a personal conversation.
            </p>
          </div>

          <!-- Direct Instant Channels (WhatsApp, Instagram, Email) -->
          <div class="space-y-4 pt-4 border-t border-[#F0E4D8]">
            <span class="text-xs font-bold uppercase tracking-wider text-[#2C1810] block">
              Direct Channels & Atelier Contact
            </span>

            <!-- WhatsApp Direct Redirect (TODO.txt requirement #6) -->
            <a 
              href="https://wa.me/?text=Hello%20CakeyTales!%20I%20would%20love%20to%20discuss%20a%20bespoke%20cake%20commission%20for%20my%20upcoming%20event." 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 rounded-2xl bg-[#FAF6F0] hover:bg-[#FCECEF]/60 border border-[#F0E4D8] transition-all duration-300 group"
            >
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-full bg-[#25D366]/10 text-[#25D366] flex items-center justify-center font-bold text-lg">
                  💬
                </span>
                <div>
                  <strong class="text-sm text-[#2C1810] block group-hover:text-[#E34A6F] transition-colors">
                    Chat Directly on WhatsApp
                  </strong>
                  <span class="text-xs text-[#8E7A70]">
                    [WhatsApp: +1 555-CAKEY-TALES / Atelier Desk]
                  </span>
                </div>
              </div>
              <span class="text-[#E34A6F] text-sm font-bold group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <!-- Instagram Redirect (TODO.txt requirement #6) -->
            <a 
              href="https://instagram.com" 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 rounded-2xl bg-[#FAF6F0] hover:bg-[#FCECEF]/60 border border-[#F0E4D8] transition-all duration-300 group"
            >
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-full bg-[#E1306C]/10 text-[#E1306C] flex items-center justify-center font-bold text-lg">
                  📷
                </span>
                <div>
                  <strong class="text-sm text-[#2C1810] block group-hover:text-[#E34A6F] transition-colors">
                    Follow & DM on Instagram
                  </strong>
                  <span class="text-xs text-[#8E7A70]">
                    [@cakeytales — Daily Atelier Stories & Reels]
                  </span>
                </div>
              </div>
              <span class="text-[#E34A6F] text-sm font-bold group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <!-- Atelier Email Contact -->
            <a 
              href="mailto:commissions@cakeytales.art" 
              class="flex items-center justify-between p-4 rounded-2xl bg-[#FAF6F0] hover:bg-[#FCECEF]/60 border border-[#F0E4D8] transition-all duration-300 group"
            >
              <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-full bg-[#E34A6F]/10 text-[#E34A6F] flex items-center justify-center font-bold text-lg">
                  ✉
                </span>
                <div>
                  <strong class="text-sm text-[#2C1810] block group-hover:text-[#E34A6F] transition-colors">
                    Email the Atelier Directly
                  </strong>
                  <span class="text-xs text-[#8E7A70]">
                    [commissions@cakeytales.art]
                  </span>
                </div>
              </div>
              <span class="text-[#E34A6F] text-sm font-bold group-hover:translate-x-1 transition-transform">↗</span>
            </a>
          </div>

          <!-- Note on appointments -->
          <div class="p-4 rounded-2xl bg-[#FDF1CE]/60 border border-[#FAEAAC] text-xs text-[#6B554B]">
            <strong class="text-[#2C1810] block mb-1">Private Consultations & Cake Tastings</strong>
            Held by appointment at our studio or scheduled via video call. Dates for the upcoming peak wedding season are accepted on a first-confirmed basis.
          </div>

        </div>

        <!-- Right Column: Interactive Commission Enquiry Form -->
        <div class="lg:col-span-7 bg-[#FAF6F0] p-6 sm:p-8 rounded-[2rem] border border-[#F0E4D8]">
          
          <div class="mb-6">
            <h3 class="font-serif text-2xl font-bold text-[#2C1810]">Commission Enquiry Form</h3>
            <p class="text-xs sm:text-sm text-[#6B554B] mt-1">
              Tell us a little about your celebration and artistic hopes. We typically respond within 24–48 hours.
            </p>
          </div>

          <form id="commission-form" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="client-name" class="block text-xs font-semibold text-[#2C1810] uppercase tracking-wider mb-1.5">
                  Your Full Name *
                </label>
                <input 
                  type="text" 
                  id="client-name" 
                  name="clientName" 
                  required 
                  placeholder="e.g. Evelyn Vance"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-[#E0D4C8] text-sm text-[#2C1810] placeholder-[#A8988E] focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:border-transparent transition-all"
                />
              </div>

              <div>
                <label for="client-email" class="block text-xs font-semibold text-[#2C1810] uppercase tracking-wider mb-1.5">
                  Email Address *
                </label>
                <input 
                  type="email" 
                  id="client-email" 
                  name="clientEmail" 
                  required 
                  placeholder="e.g. evelyn@example.com"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-[#E0D4C8] text-sm text-[#2C1810] placeholder-[#A8988E] focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:border-transparent transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="event-date" class="block text-xs font-semibold text-[#2C1810] uppercase tracking-wider mb-1.5">
                  Event Date *
                </label>
                <input 
                  type="date" 
                  id="event-date" 
                  name="eventDate" 
                  required 
                  class="w-full px-4 py-3 rounded-xl bg-white border border-[#E0D4C8] text-sm text-[#2C1810] focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:border-transparent transition-all"
                />
              </div>

              <div>
                <label for="occasion-type" class="block text-xs font-semibold text-[#2C1810] uppercase tracking-wider mb-1.5">
                  Occasion Type *
                </label>
                <select 
                  id="occasion-type" 
                  name="occasionType" 
                  required
                  class="w-full px-4 py-3 rounded-xl bg-white border border-[#E0D4C8] text-sm text-[#2C1810] focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:border-transparent transition-all"
                >
                  <option value="">Select celebration type...</option>
                  <option value="Wedding Nuptials">Wedding Nuptials (Multi-Tier)</option>
                  <option value="Sculptural Milestone Cake">Sculptural Milestone Cake</option>
                  <option value="Anniversary Gala">Anniversary Gala / Private Dinner</option>
                  <option value="Editorial & Brand Event">Editorial / Fashion Gala Commission</option>
                  <option value="Intimate Celebration">Intimate Signature Cake</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="guest-count" class="block text-xs font-semibold text-[#2C1810] uppercase tracking-wider mb-1.5">
                  Estimated Guest Count
                </label>
                <input 
                  type="text" 
                  id="guest-count" 
                  name="guestCount" 
                  placeholder="e.g. 80 - 120 guests"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-[#E0D4C8] text-sm text-[#2C1810] placeholder-[#A8988E] focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:border-transparent transition-all"
                />
              </div>

              <div>
                <label for="event-venue" class="block text-xs font-semibold text-[#2C1810] uppercase tracking-wider mb-1.5">
                  Venue / City Location
                </label>
                <input 
                  type="text" 
                  id="event-venue" 
                  name="eventVenue" 
                  placeholder="e.g. Botanical Glasshouse, London"
                  class="w-full px-4 py-3 rounded-xl bg-white border border-[#E0D4C8] text-sm text-[#2C1810] placeholder-[#A8988E] focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:border-transparent transition-all"
                />
              </div>
            </div>

            <div>
              <label for="vision-notes" class="block text-xs font-semibold text-[#2C1810] uppercase tracking-wider mb-1.5">
                Artistic Vision, Theme & Details
              </label>
              <textarea 
                id="vision-notes" 
                name="visionNotes" 
                rows="4" 
                placeholder="Share your design ideas, floral references, aesthetic mood, and any favorite flavors or allergies..."
                class="w-full px-4 py-3 rounded-xl bg-white border border-[#E0D4C8] text-sm text-[#2C1810] placeholder-[#A8988E] focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:border-transparent transition-all resize-none"
              ></textarea>
            </div>

            <div class="pt-2">
              <button 
                type="submit" 
                id="submit-enquiry-btn"
                class="w-full py-4 px-6 text-sm sm:text-base font-semibold text-white bg-[#E34A6F] hover:bg-[#CF375C] rounded-full shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:ring-offset-2 flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Submit Commission Enquiry</span>
                <span class="text-lg">✦</span>
              </button>
            </div>

            <p class="text-[11px] text-[#8E7A70] text-center pt-1">
              We respect your privacy. No spam. A bespoke commission is a personal conversation.
            </p>

          </form>

          <!-- Success Message Feedback State (Hidden by default) -->
          <div id="form-success-state" class="hidden p-8 rounded-2xl bg-[#FFFDF9] border border-[#F7D6DC] text-center space-y-4 animate-in fade-in duration-300">
            <div class="w-14 h-14 rounded-full bg-[#FCECEF] text-[#E34A6F] text-2xl flex items-center justify-center mx-auto">
              ✓
            </div>
            <h4 class="font-serif text-2xl font-bold text-[#2C1810]">Thank You for Reaching Out</h4>
            <p class="text-sm text-[#6B554B] max-w-md mx-auto leading-relaxed">
              Your commission enquiry has been prepared. We review dates carefully to ensure undivided focus for each celebration. You will receive an initial response within 24–48 hours.
            </p>
            <div class="pt-2 flex flex-wrap justify-center gap-3">
              <a 
                href="https://wa.me/?text=Hello%20CakeyTales!%20I%20just%20submitted%20a%20commission%20enquiry%20form%20and%20wanted%20to%20say%20hello." 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-5 py-2.5 rounded-full bg-[#25D366] text-white text-xs font-semibold hover:opacity-90 transition-opacity"
              >
                Follow up on WhatsApp ↗
              </a>
              <button 
                type="button" 
                id="reset-form-btn"
                class="px-5 py-2.5 rounded-full bg-white border border-[#E0D4C8] text-xs font-medium text-[#2C1810] hover:bg-[#FCECEF]/40 transition-colors"
              >
                Send Another Note
              </button>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('commission-form') as HTMLFormElement;
  const successState = document.getElementById('form-success-state');
  const resetBtn = document.getElementById('reset-form-btn');

  if (form && successState) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Simulate smooth submit handling
      const submitBtn = document.getElementById('submit-enquiry-btn');
      if (submitBtn) {
        submitBtn.innerHTML = `<span>Preparing Your Note...</span> <span class="animate-spin">✦</span>`;
      }

      setTimeout(() => {
        form.classList.add('hidden');
        successState.classList.remove('hidden');
      }, 700);
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      form.classList.remove('hidden');
      successState.classList.add('hidden');
      const submitBtn = document.getElementById('submit-enquiry-btn');
      if (submitBtn) {
        submitBtn.innerHTML = `<span>Submit Commission Enquiry</span> <span class="text-lg">✦</span>`;
      }
    });
  }
</script>
