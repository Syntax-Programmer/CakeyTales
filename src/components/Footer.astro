---
const currentYear = 2026;
---

<footer class="bg-[#F7F1E8] border-t border-[#EFE4D8] text-[#6B554B] pt-16 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-[#E8DACB]">
      
      <!-- Brand & Artist Statement Column -->
      <div class="lg:col-span-5 space-y-4">
        <a href="#" class="inline-flex items-center gap-2.5 group">
          <span class="w-8 h-8 rounded-full bg-[#FCECEF] border border-[#F7D6DC] flex items-center justify-center text-[#E34A6F] font-serif text-lg font-bold shadow-xs">
            ✦
          </span>
          <span class="font-serif text-2xl tracking-tight font-medium text-[#2C1810] group-hover:text-[#E34A6F] transition-colors">
            CakeyTales
          </span>
        </a>
        <p class="text-sm font-light text-[#6B554B] max-w-sm leading-relaxed">
          An independent cake artist studio crafting bespoke sculptural cakes for luxury weddings, intimate galas, and life's sweetest milestones.
        </p>
        <div class="pt-2 text-xs text-[#8E7A70] flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
          <span>Commission book open for 2026 / 2027 celebrations</span>
        </div>
      </div>

      <!-- Atelier Navigation -->
      <div class="lg:col-span-3 space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-[#2C1810] block">
          Navigation
        </span>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#hero" class="hover:text-[#E34A6F] transition-colors">Home & Atelier</a>
          </li>
          <li>
            <a href="#creations" class="hover:text-[#E34A6F] transition-colors">Creations Archive</a>
          </li>
          <li>
            <a href="#story" class="hover:text-[#E34A6F] transition-colors">Artist Story & Philosophy</a>
          </li>
          <li>
            <a href="#signature" class="hover:text-[#E34A6F] transition-colors">Signature Case Study</a>
          </li>
          <li>
            <a href="#process" class="hover:text-[#E34A6F] transition-colors">Creative Process</a>
          </li>
          <li>
            <a href="#enquiries" class="hover:text-[#E34A6F] transition-colors">Custom Enquiries</a>
          </li>
        </ul>
      </div>

      <!-- Atelier & Social Channels (Redirects) -->
      <div class="lg:col-span-4 space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-[#2C1810] block">
          Connect & Consultations
        </span>
        <ul class="space-y-2 text-sm">
          <li>
            <a 
              href="https://instagram.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-[#E34A6F] transition-colors flex items-center gap-2"
            >
              <span>Instagram Portfolio</span>
              <span class="text-xs text-[#8E7A70]">[@cakeytales]</span>
              <span>↗</span>
            </a>
          </li>
          <li>
            <a 
              href="https://wa.me" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-[#E34A6F] transition-colors flex items-center gap-2"
            >
              <span>WhatsApp Direct Atelier</span>
              <span class="text-xs text-[#8E7A70]">[+1 555-CAKEY-TALES]</span>
              <span>↗</span>
            </a>
          </li>
          <li>
            <a 
              href="mailto:commissions@cakeytales.art" 
              class="hover:text-[#E34A6F] transition-colors flex items-center gap-2"
            >
              <span>Atelier Inquiries</span>
              <span class="text-xs text-[#8E7A70]">[commissions@cakeytales.art]</span>
              <span>↗</span>
            </a>
          </li>
        </ul>

        <div class="pt-4 border-t border-[#E8DACB] text-xs text-[#8E7A70]">
          <span>Studio Atelier • Consultations by appointment only</span>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Philosophy Note -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8E7A70]">
      <p>
        © {currentYear} CakeyTales. All rights reserved. Handcrafted with devotion for life's sweetest moments.
      </p>
      <div class="flex items-center gap-6">
        <span>Bespoke Confectionery Atelier</span>
        <span>✦</span>
        <span>Strictly Non-Commercial Retail</span>
      </div>
    </div>

  </div>
</footer>
