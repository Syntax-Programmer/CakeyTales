---
---

<section id="signature" class="py-16 sm:py-24 bg-[#FAF6F0] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Eyebrow -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FDF1CE] border border-[#FAEAAC] text-xs font-semibold tracking-wider text-[#6B554B] uppercase mb-4">
        <span>✦</span>
        Mini Editorial Case Study
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#2C1810] tracking-tight leading-tight">
        Signature Creation: <span class="text-[#E34A6F] italic font-normal">The Empress Whisper</span>
      </h2>
      <p class="text-base sm:text-lg text-[#6B554B] font-light mt-3 leading-relaxed">
        A deep dive into the inspiration, botanical engineering, and artistic dialogue behind a singular 4-tier wedding centerpiece.
      </p>
    </div>

    <!-- Case Study Editorial Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left Column: Large Hero Finished Cake Photography -->
      <div class="lg:col-span-7 space-y-6">
        <div class="relative bg-white rounded-[2.5rem] p-3 sm:p-4 border border-[#F0E4D8] shadow-[0_20px_50px_rgba(44,24,16,0.08)] overflow-hidden group">
          <img 
            src="/images/casestudy-main.jpg" 
            alt="The Empress Whisper - 4-tier architectural cake with delicate wafer florals and gilded accents" 
            class="w-full h-[450px] sm:h-[580px] object-cover rounded-[2rem] transition-transform duration-700 group-hover:scale-102"
            loading="lazy"
          />
          
          <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-white/95 backdrop-blur-md border border-[#F0E4D8]/80 shadow-md flex items-center justify-between">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#E34A6F] block">Commission Focus</span>
              <span class="font-serif text-base sm:text-lg font-bold text-[#2C1810]">Provence Vineyard Nuptials</span>
            </div>
            <span class="text-xs text-[#8E7A70] italic">Private Collection • 2026</span>
          </div>
        </div>

        <!-- Process & Detail Photographic Pair -->
        <div class="grid grid-cols-2 gap-4 sm:gap-6">
          <div class="bg-white rounded-2xl p-2.5 sm:p-3 border border-[#F0E4D8] shadow-sm group">
            <div class="h-44 sm:h-52 overflow-hidden rounded-xl bg-[#F6EDE3]">
              <img 
                src="/images/casestudy-detail1.jpg" 
                alt="Process detail: delicate hand-piped relief and sugar lace craftsmanship" 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="pt-2 px-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#8E7A70] block">Process Study I</span>
              <span class="text-xs font-serif font-bold text-[#2C1810]">Piped Relief & Textural Drift</span>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-2.5 sm:p-3 border border-[#F0E4D8] shadow-sm group">
            <div class="h-44 sm:h-52 overflow-hidden rounded-xl bg-[#F6EDE3]">
              <img 
                src="/images/casestudy-detail2.jpg" 
                alt="Process detail: handcrafted wafer sugar flowers with 24k gold leaf" 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="pt-2 px-1">
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#8E7A70] block">Process Study II</span>
              <span class="text-xs font-serif font-bold text-[#2C1810]">Wafer Botanicals & 24K Flecks</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Case Study Dossier Specs & Narrative -->
      <div class="lg:col-span-5 space-y-8">
        
        <!-- Concept Narrative -->
        <div class="bg-[#FFFDF9] rounded-[2rem] p-6 sm:p-8 border border-[#F0E4D8] shadow-sm space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-[#E34A6F] block">
            01 / Inspiration & Concept
          </span>
          <h3 class="font-serif text-2xl font-bold text-[#2C1810]">
            Neoclassical Proportions Meets French Meadow Wildness
          </h3>
          <p class="text-sm text-[#6B554B] font-light leading-relaxed">
            The couple envisioned a centerpiece honoring the limestone balustrades of their 18th-century venue while avoiding stiff, traditional formal confectionery. We developed an asymmetrical floral ascent, allowing wafer-paper sweet peas and ivory peonies to visually "climb" the tiers as though wild vines had overtaken an ancient garden pedestal.
          </p>
        </div>

        <!-- Craftsmanship & Texture Breakdown -->
        <div class="bg-[#FFFDF9] rounded-[2rem] p-6 sm:p-8 border border-[#F0E4D8] shadow-sm space-y-5">
          <span class="text-xs font-bold uppercase tracking-widest text-[#E34A6F] block">
            02 / Artistry & Materiality
          </span>

          <div class="space-y-4 text-xs sm:text-sm">
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 rounded-full bg-[#E34A6F] mt-1.5 shrink-0"></div>
              <div>
                <strong class="text-[#2C1810] block font-medium">Textured Porcelain Buttercream</strong>
                <span class="text-[#6B554B] font-light">Custom stone-trowel finish creating soft matte shadows under ambient candlelight.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-2 h-2 rounded-full bg-[#E34A6F] mt-1.5 shrink-0"></div>
              <div>
                <strong class="text-[#2C1810] block font-medium">Translucent Wafer Petals</strong>
                <span class="text-[#6B554B] font-light">Over 140 individually shaped potato-starch wafer petals, hand-veined and petal-dusted in blush.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-2 h-2 rounded-full bg-[#E34A6F] mt-1.5 shrink-0"></div>
              <div>
                <strong class="text-[#2C1810] block font-medium">Structural Balance & Height</strong>
                <span class="text-[#6B554B] font-light">4 tiers measuring 34 inches in height, calibrated for indoor & outdoor terrace conditions.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-2 h-2 rounded-full bg-[#E34A6F] mt-1.5 shrink-0"></div>
              <div>
                <strong class="text-[#2C1810] block font-medium">Flavor Architecture</strong>
                <span class="text-[#6B554B] font-light">Layers of Sicilian pistachio dacquoise, lemon blossom curd, and champagne-infused Swiss buttercream.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Commission Inquiry Card -->
        <div class="p-6 rounded-2xl bg-[#FCECEF]/60 border border-[#F7D6DC] flex items-center justify-between">
          <div>
            <h4 class="font-serif text-lg font-bold text-[#2C1810]">Envisage Your Signature Piece</h4>
            <p class="text-xs text-[#6B554B] mt-0.5">Let's discuss unique sketches for your celebration.</p>
          </div>
          <a 
            href="#enquiries" 
            class="px-4 py-2.5 text-xs font-semibold text-white bg-[#E34A6F] hover:bg-[#CF375C] rounded-full shadow-sm transition-colors shrink-0"
          >
            Start Conversation
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
