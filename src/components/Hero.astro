---
---

<section id="hero" class="relative pt-4 pb-12 sm:pt-8 sm:pb-20 lg:pt-10 lg:pb-24 overflow-hidden">
  <!-- Subtle blush-pink outer atmospheric accents -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-[2rem] sm:rounded-[2.5rem] lg:rounded-[3rem] bg-gradient-to-br from-[#FFFDF9] via-[#FAF6F0] to-[#FCECEF]/40 border border-[#F3E2E6] shadow-[0_20px_50px_rgba(227,74,111,0.06)] p-6 sm:p-10 lg:p-16 overflow-hidden">
      
      <!-- Decorative background blur spots -->
      <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-[#FCECEF] blur-3xl opacity-70 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-24 right-1/4 w-96 h-96 rounded-full bg-[#FDF1CE] blur-3xl opacity-60 pointer-events-none" aria-hidden="true"></div>

      <!-- Main Hero Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center relative z-10">
        
        <!-- Left Column: Editorial Headline & Actions -->
        <div class="lg:col-span-7 flex flex-col justify-center text-left space-y-6 sm:space-y-8">
          
          <!-- Subtle editorial eyebrow tag -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#FCECEF] border border-[#F7D6DC] text-xs font-semibold tracking-wider text-[#E34A6F] uppercase w-fit">
            <span class="w-1.5 h-1.5 rounded-full bg-[#E34A6F] animate-pulse"></span>
            Haute Confectionery & Bespoke Event Commissions
          </div>

          <!-- Main Headline -->
          <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-[4.25rem] text-[#2C1810] leading-[1.08] tracking-tight">
            Thoughtfully Made Cakes for{" "}
            <span class="text-[#E34A6F] italic font-normal tracking-normal font-serif block sm:inline">
              Every Sweet Moment
            </span>
          </h1>

          <!-- Supporting Copy -->
          <p class="text-base sm:text-lg md:text-xl text-[#6B554B] max-w-xl font-light leading-relaxed">
            Artfully designed cakes, thoughtfully crafted details, and little moments made unforgettable. Handcrafted single-batch commissions for weddings, milestone galas, and life's sweetest chapters.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a 
              href="#creations" 
              class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-[#E34A6F] hover:bg-[#CF375C] rounded-full shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 group focus:outline-none focus:ring-2 focus:ring-[#E34A6F] focus:ring-offset-2"
            >
              Explore Creations
              <svg class="w-4 h-4 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>

            <a 
              href="#story" 
              class="inline-flex items-center justify-center px-6 py-3.5 text-base font-medium text-[#2C1810] bg-white/80 hover:bg-white border border-[#EBE0D5] hover:border-[#E34A6F]/40 rounded-full shadow-xs hover:shadow-sm transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-[#2C1810]"
            >
              My Story
            </a>

            <div class="hidden sm:flex items-center gap-2 pl-2 text-xs text-[#8E7A70]">
              <span class="text-[#E34A6F]">✦</span>
              <span>Available for Bespoke Events</span>
            </div>
          </div>

          <!-- Quick Trust / Artistry Stats -->
          <div class="grid grid-cols-3 gap-4 pt-6 border-t border-[#EFE4D8]/80 max-w-lg">
            <div>
              <span class="block font-serif text-2xl sm:text-3xl font-semibold text-[#2C1810]">100%</span>
              <span class="text-xs text-[#8E7A70] tracking-wide uppercase font-sans">Artisanal Scratch</span>
            </div>
            <div>
              <span class="block font-serif text-2xl sm:text-3xl font-semibold text-[#2C1810]">Bespoke</span>
              <span class="text-xs text-[#8E7A70] tracking-wide uppercase font-sans">Custom Sculpted</span>
            </div>
            <div>
              <span class="block font-serif text-2xl sm:text-3xl font-semibold text-[#2C1810]">Limited</span>
              <span class="text-xs text-[#8E7A70] tracking-wide uppercase font-sans">Weekly Commissions</span>
            </div>
          </div>

        </div>

        <!-- Right Column: Striking Tilted Photographic Composition -->
        <div class="lg:col-span-5 relative flex justify-center lg:justify-end items-center mt-6 lg:mt-0">
          
          <!-- Pale butter-yellow organic circular shape behind the main photograph -->
          <div 
            class="absolute w-72 h-72 sm:w-96 sm:h-96 md:w-[28rem] md:h-[28rem] bg-[#FDF1CE] rounded-[52%_48%_65%_35%/45%_55%_45%_55%] opacity-90 transition-transform duration-1000 animate-pulse-glow -z-0"
            aria-hidden="true"
          ></div>

          <!-- Secondary pale blush organic halo -->
          <div 
            class="absolute w-64 h-64 sm:w-80 sm:h-80 bg-[#FCECEF] rounded-[40%_60%_50%_50%/60%_40%_60%_40%] -top-4 -right-4 opacity-80 -z-0"
            aria-hidden="true"
          ></div>

          <!-- Main Cake Photograph in slightly tilted image frame -->
          <div class="relative z-10 w-full max-w-sm sm:max-w-md transform rotate-2 hover:rotate-0 transition-transform duration-700 ease-out">
            <div class="relative p-2 sm:p-2.5 bg-white/95 rounded-[2rem] sm:rounded-[2.5rem] shadow-[0_25px_60px_-15px_rgba(44,24,16,0.18)] border border-[#F0E4D8]/90 overflow-hidden group">
              <img 
                src="/images/hero-cake.jpg" 
                alt="Architectural multi-tiered artisanal wedding cake with handcrafted botanical flowers and cream buttercream" 
                class="w-full h-[360px] sm:h-[450px] object-cover rounded-[1.6rem] sm:rounded-[2rem] transition-transform duration-700 group-hover:scale-105"
                loading="eager"
                fetchpriority="high"
              />
              
              <!-- Subtle gloss reflection overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-white/10 pointer-events-none rounded-[1.6rem] sm:rounded-[2rem]"></div>
            </div>

            <!-- Overlapping Featured Creation Label -->
            <div class="absolute -bottom-6 -left-3 sm:-bottom-8 sm:-left-6 z-20 max-w-[270px] sm:max-w-[300px] p-4 rounded-2xl bg-white/95 backdrop-blur-md border border-[#F3E2E6] shadow-[0_12px_30px_rgba(44,24,16,0.12)]">
              <div class="flex items-start gap-3">
                <span class="w-3 h-3 rounded-full bg-[#E34A6F] mt-1 shrink-0"></span>
                <div>
                  <span class="text-[10px] font-bold tracking-wider uppercase text-[#E34A6F] block">
                    Featured Creation
                  </span>
                  <h3 class="font-serif text-base sm:text-lg font-bold text-[#2C1810] leading-tight">
                    The Rosewater Bloom
                  </h3>
                  <p class="text-xs text-[#6B554B] mt-1 leading-snug">
                    Hand-piped botanical petals with spun sugar veil and edible gold luster.
                  </p>
                </div>
              </div>
            </div>

            <!-- Small Floating Pastry / Macaron Accent Cutout -->
            <div class="absolute -top-6 -left-6 sm:-top-8 sm:-left-8 z-20 animate-float-gentle hidden sm:block">
              <div class="p-1.5 bg-white/90 backdrop-blur-md rounded-2xl shadow-lg border border-[#F7D6DC] w-20 h-20 overflow-hidden flex items-center justify-center">
                <img 
                  src="/images/floating-pastry.jpg" 
                  alt="Delicate pastel strawberry macarons" 
                  class="w-full h-full object-cover rounded-xl"
                  loading="lazy"
                />
              </div>
            </div>

            <!-- Second Floating Decorative Badge -->
            <div class="absolute -top-4 -right-2 z-20 animate-float-reverse hidden sm:block">
              <div class="px-3 py-1.5 bg-[#FDF1CE]/95 backdrop-blur-sm rounded-full shadow-sm border border-[#FAEAAC] text-[11px] font-semibold text-[#6B554B] flex items-center gap-1.5">
                <span>✦</span>
                <span>Tiered Botanical</span>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- Subtle Scroll Indicator -->
      <div class="relative z-10 flex flex-col items-center justify-center pt-10 sm:pt-14 text-center">
        <a 
          href="#creations" 
          class="group flex flex-col items-center text-[#8E7A70] hover:text-[#E34A6F] transition-colors focus:outline-none"
          aria-label="Scroll down to view portfolio creations"
        >
          <span class="text-xs font-medium tracking-widest uppercase mb-2 group-hover:tracking-[0.15em] transition-all">
            Scroll to Explore
          </span>
          <div class="w-6 h-10 rounded-full border-2 border-[#D9C8BC] group-hover:border-[#E34A6F] flex items-start justify-center p-1.5 transition-colors">
            <div class="w-1.5 h-2.5 rounded-full bg-[#E34A6F] animate-bounce"></div>
          </div>
        </a>
      </div>

    </div>
  </div>
</section>
