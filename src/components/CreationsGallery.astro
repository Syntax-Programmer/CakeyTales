  },
  {
    id: "cake-9",
    title: "Wild Berries & Pistachio Sponge",
    category: "Celebration Cakes",
    tag: "Rustic Haute",
    image: "/images/cake-9.jpg",
    description: "Bronzed Sicilian pistachio layers layered with whipped mascarpone chantilly and crowned with forest berries.",
    medium: "Bronte pistachio praline, wild raspberries, elderflower syrup",
    occasion: "Alfresco Garden Gathering",
    flavors: "Sicilian pistachio cake, whipped chantilly, elderflower berry glaze",
