const creations: CakeItem[] = [
  {
    id: "cake-1",
    title: "The Ivory Slipper & Botanical Gardenia",
    category: "Wedding Cakes",
    tag: "3-Tier Architectural",
    image: "/images/cake-1.jpg",
    description: "An ethereal triple-tier wedding centerpiece featuring hand-sculpted sugar gardenias, subtle cream ribbing, and delicate blush undertones.",
    medium: "Hand-pulled wafer paper florals, Tahitian vanilla bean chiffon, Swiss meringue",
    occasion: "Bespoke Summer Estate Wedding",
    flavors: "Madagascar vanilla, wild strawberry compote, champagne buttercream",
    gridSpan: "col-span-12 lg:col-span-8",
    heightClass: "h-[420px] sm:h-[480px]"
  },
  {
    id: "cake-2",
    title: "Petals in Solitude",
