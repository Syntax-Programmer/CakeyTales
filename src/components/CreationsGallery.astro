    gridSpan: "col-span-12 lg:col-span-4",
    heightClass: "h-[420px] sm:h-[480px]"
  },
  {
    id: "cake-3",
    title: "Monceau Gilded Tier",
    category: "Wedding Cakes",
    tag: "French Heritage",
    image: "/images/cake-3.jpg",
    description: "Regal ivory tiers crowned with 24-karat edible gold flecks and hand-piped neoclassical swags celebrating timeless romance.",
    medium: "24k gold leaf, organic passionfruit ganache, almond dacquoise",
    occasion: "Black-Tie Estate Nuptials",
    flavors: "Almond sponge, passionfruit silk, French buttercream",
    gridSpan: "col-span-12 sm:col-span-6 lg:col-span-4",
    heightClass: "h-[380px] sm:h-[420px]"
  },
  {
    id: "cake-4",
    title: "Blush Mirage & Spring Peony",
    category: "Celebration Cakes",
    tag: "Velvet Buttercream",
    image: "/images/cake-4.jpg",
    description: "Delicate strawberry velvet ombre finish supporting an oversized handmade sugar peony with spun-sugar pistils.",
    medium: "Wafer paper peony, strawberry blossom infusion, white peach confit",
    occasion: "Milestone Anniversary",
    flavors: "White peach chiffon, elderflower mousse, raspberry glaze",
    gridSpan: "col-span-12 sm:col-span-6 lg:col-span-4",
    heightClass: "h-[380px] sm:h-[420px]"
  },
  {
    id: "cake-5",
    title: "Velvet Noir & Roasted Hazelnut",
    category: "Signature Designs",
    tag: "Haute Chocolate",
    image: "/images/cake-5.jpg",
    description: "Deep 72% Valrhona dark chocolate mirror glaze offset by roasted hazelnut praline textures and spun amber sugar.",
    medium: "Dark mirror glaze, Valrhona Guanaja cocoa, candied hazelnut bark",
    occasion: "Intimate Autumn Soirée",
    flavors: "Dark chocolate ganache, hazelnut feuilletine, salted caramel",
    gridSpan: "col-span-12 sm:col-span-12 lg:col-span-4",
    heightClass: "h-[380px] sm:h-[420px]"
  },
  {
    id: "cake-6",
    title: "Fête de Printemps",
