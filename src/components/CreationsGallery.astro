---
interface CakeItem {
  id: string;
  title: string;
  category: "Wedding Cakes" | "Sculptural Cakes" | "Celebration Cakes" | "Signature Designs";
  tag: string;
  image: string;
  description: string;
  medium: string;
  occasion: string;
  flavors: string;
  gridSpan: string;
  heightClass: string;
