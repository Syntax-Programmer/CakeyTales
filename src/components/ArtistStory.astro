---
---

<section id="story" class="py-16 sm:py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Outer Editorial Container with Deep-Chocolate Contrast Panel -->
    <div class="relative rounded-[2.5rem] sm:rounded-[3rem] bg-[#2C1810] text-[#FAF6F0] p-6 sm:p-12 lg:p-16 shadow-[0_25px_60px_rgba(44,24,16,0.25)] border border-[#4A3328] overflow-hidden">
      
      <!-- Subtle atmospheric lighting halos -->
      <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-[#E34A6F] opacity-15 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-[#FDF1CE] opacity-10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center relative z-10">
        
        <!-- Left Column: Layered Artist Photographic Composition -->
        <div class="lg:col-span-5 relative flex justify-center">
          
          <!-- Butter-yellow organic circular backer -->
          <div 
            class="absolute w-64 h-64 sm:w-80 sm:h-80 bg-[#FDF1CE]/20 rounded-[50%_50%_40%_60%/60%_40%_60%_40%] -top-6 -left-6 blur-md pointer-events-none"
            aria-hidden="true"
          ></div>

          <!-- Main Artist Decorating Photo -->
          <div class="relative w-full max-w-sm sm:max-w-md">
            <div class="relative p-2 bg-[#FAF6F0]/10 backdrop-blur-md rounded-[2rem] border border-[#FAF6F0]/20 shadow-2xl overflow-hidden group">
              <img 
                src="/images/artist-at-work.jpg" 
                alt="Cake artist delicately placing handcrafted sugar petals and decorating an intricate tiered cake" 
                class="w-full h-[400px] sm:h-[480px] object-cover rounded-[1.6rem] transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none rounded-[1.6rem]"></div>
            </div>

            <!-- Overlapping Portrait / Atelier Badge -->
            <div class="absolute -bottom-6 -right-2 sm:-bottom-8 sm:-right-4 p-4 rounded-2xl bg-[#FAF6F0] text-[#2C1810] border border-[#F3E2E6] shadow-xl max-w-[240px]">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full overflow-hidden border border-[#E34A6F] shrink-0">
                  <img 
                    src="/images/artist-portrait.jpg" 
                    alt="Cake artist in studio atelier" 
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div>
                  <span class="text-[10px] font-bold tracking-widest uppercase text-[#E34A6F] block">
                    Meet The Artist
                  </span>
                  <span class="text-xs font-semibold text-[#2C1810] block font-sans">
                    [Artist / Founder Name]
                  </span>
                  <span class="text-[10px] text-[#6B554B]">
                    CakeyTales Atelier
                  </span>
                </div>
              </div>
            </div>

          </div>

        </div>

        <!-- Right Column: Editorial Philosophy & Story Panel -->
        <div class="lg:col-span-7 flex flex-col justify-center space-y-6 sm:space-y-8 lg:pl-6">
          
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAF6F0]/10 border border-[#FAF6F0]/20 text-xs font-semibold tracking-wider text-[#FCECEF] uppercase w-fit">
            <span>✦</span>
            Artist Identity & Creative Philosophy
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#FAF6F0] leading-[1.15] tracking-tight">
            The Hand & Heart Behind <span class="text-[#E34A6F] italic">CakeyTales</span>
          </h2>

          <!-- Highlight Statement -->
          <blockquote class="border-l-2 border-[#E34A6F] pl-5 sm:pl-6 my-2">
            <p class="font-serif text-2xl sm:text-3xl text-[#FCECEF] italic font-normal leading-snug">
              “Every cake is a little world of its own.”
            </p>
          </blockquote>

          <div class="space-y-4 text-sm sm:text-base text-[#D4C3BA] font-light leading-relaxed">
            <p>
              I believe cakes are not merely baked goods—they are edible sculptures crafted to anchor the emotional memory of life's most meaningful milestones. From the architectural balance of multiple tiers to the delicate curve of a sugar-pulled gardenia petal, every gesture is intentional.
            </p>
            <p>
              My process merges classical French pastry technique with modern botanical illustration and contemporary ceramic shapes. Working by private commission only, I limit commissions each month to pour singular care into every crumb, cream fold, and floral placement.
            </p>
          </div>

          <!-- Artist Details Placeholders Box -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-[#4A3328] text-xs">
            <div class="p-3.5 rounded-xl bg-[#FAF6F0]/5 border border-[#FAF6F0]/10">
              <span class="text-[#8E7A70] block uppercase tracking-wider mb-1 font-semibold">Artist Credentials</span>
              <p class="text-[#FAF6F0]">[Artisan Baker & Cake Sculptor — Placeholder]</p>
            </div>
            <div class="p-3.5 rounded-xl bg-[#FAF6F0]/5 border border-[#FAF6F0]/10">
              <span class="text-[#8E7A70] block uppercase tracking-wider mb-1 font-semibold">Studio Location</span>
              <p class="text-[#FAF6F0]">[Private Atelier — By Appointment Only]</p>
            </div>
          </div>

          <!-- Direct Connect Redirects (Instagram & WhatsApp) -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a 
              href="https://instagram.com" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#E34A6F] hover:bg-[#CF375C] text-white text-xs sm:text-sm font-semibold transition-all duration-300 shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Follow on Instagram</span>
            </a>

            <a 
              href="https://wa.me" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#FAF6F0]/10 hover:bg-[#FAF6F0]/20 text-[#FAF6F0] border border-[#FAF6F0]/20 text-xs sm:text-sm font-medium transition-all duration-300"
            >
              <span>WhatsApp Atelier Chat</span>
              <span>↗</span>
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
