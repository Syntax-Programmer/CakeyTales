---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CakeyTales — Haute Confectionery & Bespoke Cake Artistry",
  description = "A personal cake artistry atelier by CakeyTales. Sculptural wedding cakes, artistic event centerpieces, and thoughtfully handcrafted confections for life's sweetest moments."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-cake.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Cormorant Garamond, Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#FAF6F0] text-[#2C1810] font-sans antialiased selection:bg-[#E34A6F] selection:text-white min-h-screen overflow-x-hidden">
    <slot />
  </body>
</html>
